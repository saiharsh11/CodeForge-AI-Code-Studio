# ── Model providers ─────────────────────────────────────────────
# Required. Free key at https://openrouter.ai — only free models are offered.
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional. If set, Groq's models are added to the model list (https://console.groq.com).
# GROQ_API_KEY=

# Optional: which free models to offer, in order (the first is the default).
# Must match the "Model & provider access" guardrail on your OpenRouter key.
# MODEL_ALLOWLIST=cohere/north-mini-code:free,nvidia/nemotron-3-ultra-550b-a55b:free

# Optional. Your public site URL, sent to OpenRouter for attribution.
# APP_URL=https://your-site.vercel.app

# ── Guardrails ──────────────────────────────────────────────────
# Browser origins allowed to call this API (comma-separated, no trailing slash).
# In production this must list your frontend's URL. Localhost dev origins are
# allowed automatically unless NODE_ENV=production.
# ALLOWED_ORIGINS=https://your-site.vercel.app

# Per-visitor limits (visitors are told apart by a salted hash of the IP, kept
# in memory only and dropped after 24h).
# RATE_CHAT_PER_MIN=6
# RATE_CHAT_PER_DAY=30
# RATE_READS_PER_MIN=60
# RATE_CONCURRENT=2

# Number of reverse-proxy hops in front of the server (Railway: 1).
# TRUST_PROXY=1

PORT=3000
